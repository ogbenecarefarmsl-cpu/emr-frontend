# Backend API URL
# For localhost development
VITE_API_URL=http://localhost:3000

# For production deployment, set this in Cloudflare to your DigitalOcean backend URL.
# Example:
# VITE_API_URL=https://api.your-domain.com

# For LAN access (uncomment and replace with your server IP)
# VITE_API_URL=http://192.168.1.100:3000
